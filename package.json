{
  "name": "heyi-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:editor": "cross-env VITE_APP_MODE=editor vite",
    "server": "tsx server/local-server.ts",
    "editor": "concurrently -k -n SERVER,WEB -c blue,magenta \"npm run server\" \"npm run dev:editor\"",
    "build": "vite build",
    "build:viewer": "cross-env VITE_APP_MODE=viewer vite build",
    "build:editor": "cross-env VITE_APP_MODE=editor vite build",
    "export": "tsx server/export-static.ts",
    "export:single": "tsx server/export-static.ts --single",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "@types/express": "^4.17.21",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
